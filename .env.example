# Copy to .env with chmod 600, then replace SESSION_PASSWORD with a unique random value (32+ characters).
DATABASE_URL=file:./data/family.db
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
SESSION_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Production must use https://ellie-rewards.duckdns.org and COOKIE_SECURE=true.
