{
  "name": "family-rewards",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "accounts": "node --env-file-if-exists=.env --import tsx scripts/accounts.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "format:check": "prettier --check src tests scripts *.ts *.json deploy/*.yaml",
    "format": "prettier --write src tests scripts *.ts *.json deploy/*.yaml"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.2.4",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "9.0.1",
    "lucide-react": "0.577.0",
    "next": "16.4.2",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.5.0",
    "tsx": "4.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
